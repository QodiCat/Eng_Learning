# API base URL including the provider's API prefix, usually /v1.
# Do not include /chat/completions. Credentials stay in this local file.
AI_BASE_URL=
AI_MODEL=
AI_API_KEY=
# Set false only if your own endpoint explicitly requires no authentication.
AI_REQUIRE_KEY=true
AI_TIMEOUT_MS=30000
AI_MAX_RESPONSE_BYTES=1048576
TRANSLATE_SHORTCUT=CommandOrControl+Alt+E
CAPTURE_TIMEOUT_MS=1500
CAPTURE_PROCESS_TIMEOUT_MS=15000
MAX_INPUT_LENGTH=200
MAX_IMPORT_BYTES=5242880
# Provisional input rule: words/phrases, no Chinese sentences.
ALLOW_CHINESE_SENTENCES=false
# Optional absolute directory; blank uses the app's userData directory.
DATA_DIRECTORY=
